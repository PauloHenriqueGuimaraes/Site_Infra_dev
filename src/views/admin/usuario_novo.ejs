<%- include('../partials/header') %>

<div class="container py-6 mt-5 animate-up">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center mb-4">
                <h6 class="text-secondary fw-bold tracking-widest text-uppercase mb-2">Administração</h6>
                <h2 class="display-6 fw-bold text-white mb-3">Cadastrar novo usuário</h2>
                <div class="title-separator mx-auto bg-gradient mb-4" style="background: linear-gradient(90deg, #64748b, #94a3b8);"></div>
            </div>

            <div class="service-card p-4 p-md-5 border border-secondary border-opacity-25 shadow-lg">
                <% if (error) { %>
                    <div class="alert alert-danger bg-danger bg-opacity-25 border-danger text-white text-center rounded-3 mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
                    </div>
                <% } %>

                <form action="/admin/usuarios/novo" method="POST">
                    <div class="mb-4">
                        <label for="nome" class="form-label text-light fw-semibold">Nome completo</label>
                        <input type="text" class="form-control form-control-lg rounded-3" id="nome" name="nome" required placeholder="Digite o nome do administrador">
                    </div>
                    
                    <div class="mb-4">
                        <label for="email" class="form-label text-light fw-semibold">E-mail</label>
                        <input type="email" class="form-control form-control-lg rounded-3" id="email" name="email" required placeholder="email@pgxtech.com">
                    </div>

                    <div class="mb-5">
                        <label for="password" class="form-label text-light fw-semibold">Senha</label>
                        <input type="password" class="form-control form-control-lg rounded-3" id="password" name="password" required placeholder="Digite uma senha forte">
                    </div>

                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-secondary btn-lg text-white rounded-pill shadow-lg hover-lift py-2 fw-bold">
                            <i class="bi bi-person-check-fill me-2"></i>Salvar Usuário
                        </button>
                        <a href="/admin/usuarios" class="btn btn-outline-light rounded-pill py-2">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
