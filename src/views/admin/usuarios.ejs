<%- include('../partials/header') %>

<div class="container-fluid py-6 mt-5 animate-up" style="max-width: 1400px;">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h6 class="text-secondary fw-bold tracking-widest text-uppercase mb-2">Painel de Controle</h6>
            <h2 class="display-6 fw-bold text-white mb-0">Gestão de usuários</h2>
            <div class="title-separator bg-gradient mt-2" style="width: 80px; background: linear-gradient(90deg, #64748b, #94a3b8);"></div>
        </div>
        <div class="d-flex gap-3">
            <a href="/admin/dashboard" class="btn btn-outline-light rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
            <a href="/admin/usuarios/novo" class="btn btn-secondary text-white rounded-pill px-4">
                <i class="bi bi-person-plus-fill me-2"></i>Novo usuário
            </a>
        </div>
    </div>

    <div class="service-card p-4 border border-secondary border-opacity-25 shadow-lg overflow-auto custom-scrollbar">
        <% if (usuarios && usuarios.length > 0) { %>
            <table class="table table-dark table-hover table-borderless align-middle mb-0">
                <thead class="border-bottom border-secondary">
                    <tr>
                        <th class="py-3 text-secondary">Nome</th>
                        <th class="py-3 text-secondary">E-mail</th>
                        <th class="py-3 text-secondary">Data de criação</th>
                        <th class="py-3 text-secondary text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% usuarios.forEach(function(user) { %>
                        <tr class="border-bottom border-gray-800" style="transition: background 0.2s;">
                            <td class="py-3 fw-bold text-white"><%= user.Nome %></td>
                            <td class="py-3 text-light opacity-75"><%= user.Email %></td>
                            <td class="py-3 text-light opacity-75">
                                <%= new Date(user.DataCriacao).toLocaleString('pt-BR') %>
                            </td>
                            <td class="py-3 text-end">
                                <% if (user.Email !== 'adm@pgxtech.com') { %>
                                    <form action="/admin/usuarios/deletar/<%= user.Id %>" method="POST" class="d-inline" onsubmit="return confirm('Tem certeza que deseja remover este usuário?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            <i class="bi bi-trash-fill me-1"></i>Remover
                                        </button>
                                    </form>
                                <% } else { %>
                                    <span class="badge bg-secondary">Mestre</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <div class="text-center py-5">
                <h4 class="text-light">Nenhum usuário encontrado.</h4>
            </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
