<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - PG Tech</title>
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <!-- Interactive Particles Background -->
    <div id="tsparticles" style="position: fixed; width: 100vw; height: 100vh; z-index: -1; top: 0; left: 0;"></div>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-glass border-bottom box-shadow mb-3 fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-gradient d-flex align-items-center gap-2" href="/">
                    <img src="/images/logo.jpg" alt="PG Tech" class="rounded-circle shadow-sm" style="height: 40px; width: 40px; object-fit: contain;" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
