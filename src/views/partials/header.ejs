<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - PG x Tech</title>
    <link rel="icon" type="image/png" href="/images/logo-brand.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <!-- Interactive Particles Background -->
    <div id="tsparticles" style="position: fixed; width: 100%; height: 100%; z-index: -1; top: 0; left: 0;"></div>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-glass border-bottom fixed-top" aria-label="Navegação principal">
            <div class="container">
                <a class="navbar-brand fw-bold text-gradient d-flex align-items-center gap-2" href="/">
                    <img src="/images/logo-brand.png" alt="PG x Tech" class="brand-logo" />
                    <span>PG <span class="brand-x">x</span> Tech</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Abrir menu de navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNav" class="navbar-collapse collapse">
                    <ul class="navbar-nav mx-auto gap-lg-3">
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/#hero">Início</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/#why-us">Por que a PG x Tech?</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/#nossos-servicos">Serviços</a>
                        </li>
                    </ul>
                    <ul class="navbar-actions navbar-nav d-flex flex-column flex-lg-row gap-2 mt-3 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-light btn btn-primary btn-sm px-3 rounded-pill fw-bold text-center" href="/orcamento">Solicitar orçamento</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light btn btn-outline-light btn-sm px-3 rounded-pill text-center" href="/contact">Fale conosco</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main id="conteudo-principal" role="main">
