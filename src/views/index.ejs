        }
        .display-6 {
            font-size: 1.5rem;
        }
        .carousel-item {
            min-height: auto !important;
            padding-bottom: 0;
        }
        .carousel-caption {
            position: relative !important;
            right: 0;
            left: 0;
            padding: 3rem 1rem 4rem 1rem !important;
        }
        .carousel-caption p.lead {
            font-size: 0.95rem;
            margin-bottom: 0;
        }
        .tech-marquee-items {
            gap: 2rem;
            padding-right: 2rem;
        }
        .tech-marquee-item img {
            height: 25px;
        }
        .tech-marquee-item span {
