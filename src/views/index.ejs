<style>
    /* Premium UI Tweaks */
    html, body { overflow-x: hidden; width: 100%; }
    .tracking-wide { letter-spacing: 0.05em; }
    .tracking-widest { letter-spacing: 0.1em; }
    .py-6 { padding-top: 5rem; padding-bottom: 5rem; }
    @media (max-width: 768px) {
        .py-6 { padding-top: 3rem; padding-bottom: 3rem; }
    }
    .mb-6 { margin-bottom: 5rem; }
    
    .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .hover-lift:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.6); z-index: 2; }
    
    .custom-scrollbar::-webkit-scrollbar { height: 8px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(225, 0, 112, 0.5); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255, 22, 79, 0.9); }
    
    .hover-scale { transition: transform 0.2s ease; filter: grayscale(20%); }
    .hover-scale:hover { transform: scale(1.15); filter: grayscale(0%); }

    .border-gray-800 { border-color: rgba(255, 255, 255, 0.1) !important; }
    
    .title-separator {
        width: 60px;
        height: 4px;
        border-radius: 2px;
        background: linear-gradient(90deg, var(--bs-primary), var(--bs-info));
    }

    .tech-circle-wrapper {
        position: relative;
        width: 350px;
        height: 350px;
    }
    .tech-circle-inner, .tech-circle-outer {
        position: absolute;
        border-radius: 50%;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
    .tech-circle-inner {
        width: 200px;
        height: 200px;
        border: 2px dashed rgba(162, 28, 255, 0.5);
        animation: spin 20s linear infinite;
    }
    .tech-circle-outer {
        width: 300px;
        height: 300px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-top-color: rgba(255, 22, 79, 0.9);
        animation: spin-reverse 30s linear infinite;
    }
    .glow-orb {
        position: absolute;
        width: 150px;
        height: 150px;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.5;
        top: 40%;
        left: 20%;
        animation: float 6s ease-in-out infinite;
    }
    
    @keyframes spin { 100% { transform: translate(-50%, -50%) rotate(360deg); } }
    @keyframes spin-reverse { 100% { transform: translate(-50%, -50%) rotate(-360deg); } }
    @keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
        100% { transform: translateY(0px); }
    }
    
    /* Marquee Styles */
    .tech-marquee-container {
        overflow: hidden;
        width: 100%;
        background: rgba(7, 5, 9, 0.86);
        border-top: 1px solid rgba(255,255,255,0.05);
        border-bottom: 1px solid rgba(255,255,255,0.05);
        padding: 1.5rem 0;
    }
    .tech-marquee-track {
        display: flex;
        width: max-content;
        animation: marquee 30s linear infinite;
    }
    .tech-marquee-track:hover {
        animation-play-state: paused;
    }
    .tech-marquee-items {
        display: flex;
        gap: 5rem;
        padding-right: 5rem;
    }
    .tech-marquee-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        color: rgba(255,255,255,0.6);
        font-weight: 500;
        font-size: 1.1rem;
        transition: color 0.3s ease;
    }
    .tech-marquee-item img {
        height: 35px;
        width: auto;
        filter: grayscale(100%) opacity(0.6);
        transition: all 0.3s ease;
    }
    .tech-marquee-item:hover {
        color: rgba(255,255,255,1);
    }
    .tech-marquee-item:hover img {
        filter: none;
    }
    @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    
    /* Responsive Adjustments for Mobile */
    @media (max-width: 768px) {
        .hero-section {
            padding-top: 5rem;
            text-align: center;
        }
        .display-3 {
            font-size: 2.5rem;
        }
        .display-5 {
